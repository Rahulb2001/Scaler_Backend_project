# Copy this file to ".env" (same folder as docker-compose.yml) and fill in
# real values. ".env" is git-ignored on purpose - never commit real secrets.

# JWT signing secret used by user-authentication-service. If left blank,
# docker-compose falls back to a built-in dev-only value - fine for local
# use, not for anything real.
JWT_SECRET=

# Gmail address + app password (not your account password - generate one at
# https://myaccount.google.com/apppasswords) used by notification-service to
# actually send the signup email.
MAIL_USERNAME=
MAIL_APP_PASSWORD=

# Razorpay test-mode keys (https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Stripe test-mode key (https://dashboard.stripe.com/test/apikeys) and the
# signing secret for the webhook endpoint you configure to point at
# payment-service's /stripeWebhook (https://dashboard.stripe.com/test/webhooks)
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
